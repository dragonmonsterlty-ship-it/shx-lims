# LIMS 全栈 MVP 环境变量模板
# 复制为 backend/.env 与 frontend/.env（脚本会自动处理）。

# ===== 共享 / 数据库（docker-compose 与 backend）=====
APP_NAME=LIMS
APP_ENV=development
POSTGRES_USER=lims
POSTGRES_PASSWORD=lims
POSTGRES_DB=lims

# ===== 后端（backend/.env）=====
# Postgres 暴露在宿主机 15432（容器内 5432）
DATABASE_URL=postgresql+psycopg://lims:lims@localhost:15432/lims
# 测试库必须独立，禁止指向开发库
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 后端启动端口（start-backend.ps1 使用）
BACKEND_PORT=18000

# ===== 前端（frontend/.env）=====
VITE_API_BASE_URL=http://127.0.0.1:18000/api
VITE_API_MODE=real
